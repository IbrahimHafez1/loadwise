{
  "prismaScopes": {
    "Invoice": {
      "field": "organizationId",
      "from": "@app/auth",
      "export": "requireOrganization"
    }
  },
  "drizzleScopes": {
    "invoices": {
      "tableFrom": "@app/schema",
      "field": "workspace_id",
      "from": "@app/auth",
      "export": "currentWorkspace"
    }
  },
  "parallelReads": [
    {
      "from": "@app/reads",
      "exports": ["fetchUser", "fetchPosts"]
    }
  ],
  "dataAccess": {
    "modules": [
      "@app/db",
      "@prisma/client",
      "drizzle-orm",
      "mongoose",
      "typeorm",
      "sequelize",
      "@sequelize/core",
      "knex",
      "kysely"
    ],
    "allowIn": ["src/data"]
  }
}
