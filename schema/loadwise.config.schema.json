                "dependency-cycle",
                "drizzle-query-in-loop",
                "drizzle-scope-unverified",
                "drizzle-unfiltered-write",
                "duplicate-implementation",
                "external-call-in-transaction",
                "file-placement",
                "filter-for-existence",
                "find-then-create-race",
                "floating-promise",
                "folder-boundary",
                "guard-query-per-request",
