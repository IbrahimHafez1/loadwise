          "serial-awaits-in-literal",
          "service-query-in-loop",
          "swallowed-error",
          "typeorm-existence-materialization",
          "typeorm-load-then-save",
          "typeorm-transaction-client-escape",
          "typeorm-transaction-in-loop",
          "typeorm-wide-projection",
          "unreferenced-file",
          "unused-export",
          "upload-without-size-limit"
        ]
      },
      "additionalProperties": {
        "oneOf": [
          {
            "enum": ["off", "warn", "error"]
          },
          {
            "type": "object",
            "properties": {
              "level": {
                "enum": ["off", "warn", "error"]
              }
            },
            "required": ["level"],
            "additionalProperties": false
          }
        ]
      }
    },
    "overrides": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "files": {
            "type": "array",
