                "swallowed-error",
                "typeorm-existence-materialization",
                "typeorm-load-then-save",
                "typeorm-transaction-client-escape",
                "typeorm-transaction-in-loop",
                "typeorm-wide-projection",
                "unreferenced-file",
                "unused-export",
                "upload-without-size-limit"
              ]
            },
            "additionalProperties": {
              "oneOf": [
                {
                  "enum": ["off", "warn", "error"]
                },
                {
                  "type": "object",
                  "properties": {
                    "level": {
                      "enum": ["off", "warn", "error"]
                    }
                  },
                  "required": ["level"],
                  "additionalProperties": false
                }
              ]
            }
          }
        },
        "required": ["files", "rules"],
        "additionalProperties": false
      }
    },
    "performance": {
      "type": "object",
      "description": "The content of backend-perf.policy.json.",
      "properties": {
        "prismaScopes": {
          "type": "object"
        },
        "drizzleScopes": {
          "type": "object"
        },
        "parallelReads": {
          "type": "array"
        }
      },
      "additionalProperties": false
    },
    "maintainability": {
      "type": "object",
      "description": "The content of the maintainability policy file.",
      "properties": {
        "exclude": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "boundaries": {
          "type": "array"
        },
        "placement": {
