{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "loadwise.config.json",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "checkers": {
      "type": "array",
      "items": {
        "enum": ["perf", "maint", "sec"]
      },
      "minItems": 1,
      "description": "Default checkers for `loadwise check`; --only and --skip override it."
    },
    "ignore": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "description": "Glob patterns, relative to this file, excluded from every checker."
    },
    "rules": {
      "type": "object",
      "propertyNames": {
        "enum": [
          "api-enum-value-removed",
          "api-removed-field",
          "api-removed-operation",
          "api-required-input",
          "api-type-changed",
          "array-repeated-find",
          "array-repeated-membership",
          "await-before-early-exit",
          "count-then-page-serial",
          "data-access-boundary",
          "db-duplicate-index",
          "db-missing-index",
          "db-seq-scan-heavy-table",
          "db-slow-query-plan",
          "db-unindexed-foreign-key",
          "db-unused-index",
          "deep-control-flow",
          "dependency-cycle",
          "drizzle-query-in-loop",
          "drizzle-scope-unverified",
          "drizzle-unfiltered-write",
          "duplicate-implementation",
          "external-call-in-transaction",
          "file-placement",
          "filter-for-existence",
          "find-then-create-race",
          "floating-promise",
          "folder-boundary",
          "guard-query-per-request",
          "high-branch-complexity",
          "http-call-without-timeout",
          "index-missing-filter",
          "index-missing-foreign-key",
          "index-missing-order",
          "index-unusable-expression",
          "index-unusable-pattern",
          "known-reads-awaited-serially",
          "large-class",
          "large-module",
          "long-parameter-list",
          "loop-copy-accumulator",
          "migration-breaking-drop",
          "migration-breaking-rename",
          "migration-column-type-rewrite",
          "migration-concurrent-in-transaction",
          "migration-constraint-not-valid",
          "migration-constraint-without-index",
          "migration-index-not-concurrent",
          "migration-missing-lock-timeout",
          "migration-mysql-lock-unspecified",
          "migration-mysql-table-copy",
          "migration-not-null-without-default",
          "migration-set-not-null-scan",
          "migration-table-rewrite-command",
          "migration-unparsed",
          "migration-volatile-default",
          "mongo-collection-scan-observed",
          "node-sync-compression-in-async",
          "node-sync-crypto-in-async",
          "node-sync-fs-in-async",
          "node-sync-process-in-async",
          "numeric-sort-for-extreme",
          "orm-count-materialization",
