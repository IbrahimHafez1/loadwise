{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "categories": {
    "correctness": "error"
  },
  "env": {
    "node": true,
    "browser": false
  },
  "ignorePatterns": [
    "lib/performance/vendor/**",
    "examples/**",
    "test/performance/integration/orms/app.ts",
    "bench/recall/cases/**",
    "bin/*.cjs",
    "lib/**/*.cjs",
    "editor/**/*.cjs",
    "plugin/**/*.cjs",
    "polyglot/**/*.cjs",
    "scripts/**/*.cjs",
    "bench/**/*.cjs",
    "test/**/*.cjs"
  ],
  "plugins": ["typescript", "unicorn"],
  "rules": {
    "typescript/no-explicit-any": "error",
    "typescript/no-non-null-assertion": "error",
    "typescript/consistent-type-assertions": [
      "error",
      {
        "assertionStyle": "never"
      }
    ],
    "typescript/consistent-type-imports": "error",
    "typescript/no-require-imports": "error",
    "typescript/no-inferrable-types": "error",
    "typescript/prefer-as-const": "error",
    "unicorn/prefer-node-protocol": "error",
    "unicorn/prefer-string-replace-all": "error",
    "no-var": "error",
    "prefer-const": "error",
    "eqeqeq": [
      "error",
      "always",
      {
        "null": "ignore"
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "bench/large.cts",
        "bench/scanner.cts",
        "bench/traces.cts",
        "editor/test/extension.test.cts",
        "lib/maintainability/cli.cts",
        "lib/maintainability/inputs.cts",
        "lib/maintainability/review-directive.cts",
        "lib/maintainability/site-fix.cts",
        "lib/performance/analyze.cts",
        "lib/performance/cli.cts",
        "lib/performance/compiler.cts",
        "lib/performance/db/gateway.cts",
        "lib/performance/editor-watch.cts",
        "lib/performance/fix-cli.cts",
        "lib/performance/native-runtime.cts",
        "lib/performance/native.cts",
        "lib/performance/password-hashing.cts",
        "lib/performance/query-policy.cts",
        "lib/performance/scan-outcome.cts",
        "lib/performance/schema/prisma-schema.cts",
        "lib/performance/schema/ts-helpers.cts",
        "lib/performance/service-loops.cts",
        "lib/performance/site-fix.cts",
        "lib/performance/unscanned-javascript.cts",
        "lib/security/analyze.cts",
        "lib/security/cli.cts",
        "lib/security/files/review-directive.cts",
        "lib/security/taint/summaries.cts",
        "lib/shared/fix-hunks.cts",
        "lib/shared/fix-presentation.cts",
        "lib/shared/fix-recipes.cts",
        "lib/shared/fix-safety.cts",
        "lib/shared/fix.cts",
        "lib/shared/hot-path.cts",
        "lib/shared/pillars.cts",
        "lib/shared/review-mcp.cts",
        "lib/shared/source-report.cts",
        "lib/shared/workspaces.cts",
        "scripts/score-corpus.cts",
        "test/maintainability/changed-lines.test.cts",
        "test/maintainability/cookingschool-fixes.test.cts",
        "test/maintainability/improve-maint.test.cts",
        "test/maintainability/site-fix.test.cts",
        "test/maintainability/site-fixes-duplicate-sibling.test.cts",
        "test/maintainability/site-fixes-json-decode.test.cts",
        "test/maintainability/site-fixes-loop-guards.test.cts",
        "test/performance/agent-mode.test.cts",
        "test/performance/async-errors.test.cts",
        "test/performance/collections.test.cts",
        "test/performance/drizzle-write-preflight.test.cts",
        "test/performance/editor-migrations.test.cts",
        "test/performance/emit-only-options.test.cts",
        "test/performance/engine-selection.test.cts",
        "test/performance/helpers.cts",
        "test/performance/http-timeouts.test.cts",
        "test/performance/improve-loops.test.cts",
        "test/performance/index-redundant-prefix.test.cts",
        "test/performance/index-rules-fixtures.cts",
        "test/performance/index-rules-foreign-key.test.cts",
        "test/performance/index-rules.test.cts",
        "test/performance/model-fallbacks.test.cts",
        "test/performance/native-base-url.test.cts",
        "test/performance/native-fixture.cts",
        "test/performance/native-index-infos.test.cts",
        "test/performance/native-removed-options.test.cts",
        "test/performance/native-workspace-sources.test.cts",
        "test/performance/native.test.cts",
        "test/performance/node-fs.test.cts",
        "test/performance/prisma.test.cts",
        "test/performance/project-paths.test.cts",
        "test/performance/project-review-context.test.cts",
        "test/performance/promise-return-escapes-catch.test.cts",
        "test/performance/pure-js-hashing.test.cts",
        "test/performance/query-cli.test.cts",
        "test/performance/redundant-indexes-review.test.cts",
        "test/performance/request-handlers-frameworks.test.cts",
        "test/performance/review-context.test.cts",
        "test/performance/review-core.test.cts",
        "test/performance/review-editor.test.cts",
        "test/performance/review-schema.test.cts",
        "test/performance/review-site-fixes.test.cts",
        "test/performance/site-fix-helpers.cts",
        "test/performance/skipped-files.test.cts",
        "test/performance/stream-errors.test.cts",
        "test/performance/stream-pipe-context.test.cts",
        "test/performance/tooling-fs-context.test.cts",
        "test/security/auth-hardcoded-secret.test.cts",
        "test/security/exposure-logging.test.cts",
        "test/security/framework-sources.test.cts",
        "test/security/helpers.cts",
        "test/security/native-parity.test.cts",
        "test/shared/cookingschool-builders.test.cts",
        "test/shared/corpus-coverage-c5.test.cts",
        "test/shared/explain.test.cts",
        "test/shared/fix-verification-coverage.test.cts",
        "test/shared/fix-verification.cts",
        "test/shared/function-summaries.test.cts",
        "test/shared/hot-path.test.cts",
        "test/shared/hot-spots.test.cts",
        "test/shared/workspaces.test.cts"
      ],
      "rules": {
        "typescript/no-require-imports": "off"
      }
    }
  ]
}
