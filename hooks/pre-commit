#!/bin/sh
# Formats and lints staged source files so every commit follows the same rules. Enabled by `npm install` (prepare script).
files=$(git diff --cached --name-only --diff-filter=ACMR | grep -E '\.(cts|ts|json|md|yml)$' | grep -v '^lib/performance/vendor/')
[ -z "$files" ] && exit 0
echo "$files" | xargs npx prettier --write --ignore-unknown || exit 1
echo "$files" | xargs git add
echo "$files" | grep -E '\.(cts|ts)$' | xargs --no-run-if-empty npx oxlint --deny-warnings --no-error-on-unmatched-pattern
