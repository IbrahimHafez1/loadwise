#!/bin/sh
# Formats and lints staged source files so every commit follows the same rules. Enabled by `npm install` (prepare script).
files=$(git diff --cached --name-only --diff-filter=ACMR | grep -E '\.(cts|ts|json|md|yml)$' | grep -v '^lib/performance/vendor/')
[ -z "$files" ] && exit 0
# On Windows, npx runs through cmd.exe, which rejects a command line over 8191 characters, so xargs splits large
# commits into batches below that limit. xargs still exits non-zero when any batch fails.
max_command_chars=6000
echo "$files" | xargs -s "$max_command_chars" npx prettier --write --ignore-unknown || exit 1
echo "$files" | xargs -s "$max_command_chars" git add
echo "$files" | grep -E '\.(cts|ts)$' | xargs --no-run-if-empty -s "$max_command_chars" npx oxlint --deny-warnings --no-error-on-unmatched-pattern
