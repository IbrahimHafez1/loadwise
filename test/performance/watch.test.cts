import assert from 'node:assert/strict';
import fs from 'node:fs';
import os from 'node:os';
import path from 'node:path';
import test from 'node:test';
import { once, EventEmitter } from 'node:events';
import { watchProject } from '../../lib/performance/watch.cjs';
import type { Finding } from '../../lib/shared/types.cjs';

type WatchResult = Parameters<Parameters<typeof watchProject>[1]['onResult']>[0];

test(
  'watch reports complete snapshots, follows dependency edits, and recovers from invalid inputs',
  { timeout: 30_000 },
  async (context) => {
    const base = process.env.LOCALAPPDATA ? path.join(process.env.LOCALAPPDATA, 'Temp', 'AI-Work') : os.tmpdir();
    fs.mkdirSync(base, { recursive: true });
    const directory = fs.mkdtempSync(path.join(base, 'backend-perf-watch-'));
    const config = path.join(directory, 'tsconfig.json');
    const route = path.join(directory, 'route.ts');
    const model = path.join(directory, 'model.ts');
    const runtime = path.join(directory, 'runtime.d.ts');
    const validConfig = JSON.stringify({
      compilerOptions: { target: 'ES2022', lib: ['ES2022'], types: [], incremental: true },
      files: ['route.ts', 'model.ts', 'runtime.d.ts'],
    });
    const slowRoute = `import type { Labels, ItemDelegate } from './model';
export function select(ids: string[], labels: Labels) {
  return ids.filter(id => labels.includes(id));
}
export async function count(items: ItemDelegate) { return (await items.findMany()).length; }`;
    const freshRoute = 'export const count = 1;';
    const modelText = `// This is code generated by Prisma
import type { Item } from '@prisma/client/runtime/fixture';
export interface ItemDelegate { findMany(): Promise<Item[]> }
export type Labels = string[];`;
    fs.writeFileSync(config, validConfig);
    fs.writeFileSync(route, slowRoute);
    fs.writeFileSync(model, modelText);
    fs.writeFileSync(
      runtime,
      "declare module '@prisma/client/runtime/fixture' { export interface Item { id: string } }",
    );
    // oxlint-disable-next-line prefer-const -- the cleanup hook below closes it, so it is declared before it is assigned
    let watch: ReturnType<typeof watchProject> | undefined;
    context.after(() => {
      watch?.close();
      for (const file of [config, route, model, runtime]) if (fs.existsSync(file)) fs.unlinkSync(file);
      fs.rmdirSync(directory);
    });
    const updates = new EventEmitter();
    const callbacks = {
      onResult: (result: WatchResult) => updates.emit('update', result),
      onError: (error: unknown) => updates.emit('update', error),
    };
    async function edit(filename: string, text: string) {
      const next = once(updates, 'update');
      fs.writeFileSync(filename, text);
      return (await next)[0];
    }

    const initial = once(updates, 'update');
    watch = watchProject(config, callbacks);
    const [first] = await initial;
    assert.equal(first.scannedFiles, 2);
    assert.deepEqual(
      first.findings.map((finding: Finding) => finding.ruleId),
      ['array-repeated-membership', 'prisma-count-materialization'],
    );

    const headerEdit = await edit(model, modelText.replace('This is code generated by Prisma', 'Application model'));
    assert.deepEqual(
      headerEdit.findings.map((finding: Finding) => finding.ruleId),
      ['array-repeated-membership'],
    );
    const dependencyEdit = await edit(
      model,
      modelText.replace('type Labels = string[];', 'interface Labels { includes(id: string): boolean }'),
    );
    assert.deepEqual(
      dependencyEdit.findings.map((finding: Finding) => finding.ruleId),
      ['prisma-count-materialization'],
    );
    const restored = await edit(model, modelText);
    assert.deepEqual(restored, first);
    const invalidCode = await edit(route, 'const = ;');
    assert.ok(invalidCode instanceof Error);
    assert.match(invalidCode.message, /route\.ts/);
    assert.deepEqual(await edit(route, freshRoute), { scannedFiles: 2, findings: [] });
    const invalidConfig = await edit(config, '{ "compilerOptions": { "badOption": true } }');
    assert.ok(invalidConfig instanceof Error);
    assert.match(invalidConfig.message, /badOption/);
    const incompatibleConfig = await edit(
      config,
      JSON.stringify({
        compilerOptions: { module: 'ESNext', moduleResolution: 'NodeNext' },
        files: ['route.ts', 'model.ts', 'runtime.d.ts'],
      }),
    );
    assert.ok(incompatibleConfig instanceof Error);
    assert.match(incompatibleConfig.message, /module.*NodeNext/);
    assert.deepEqual(await edit(config, validConfig), { scannedFiles: 2, findings: [] });
    const deletion = once(updates, 'update');
    fs.unlinkSync(config);
    const [missingConfig] = await deletion;
    assert.ok(missingConfig instanceof Error);
    assert.match(missingConfig.message, /config does not exist/);
    assert.deepEqual(await edit(config, validConfig), { scannedFiles: 2, findings: [] });
    assert.deepEqual(fs.readdirSync(directory).sort(), ['model.ts', 'route.ts', 'runtime.d.ts', 'tsconfig.json']);
  },
);
