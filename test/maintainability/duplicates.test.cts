import test from 'node:test';
import assert from 'node:assert/strict';
import ts from 'typescript';
import { createDuplicateIndex } from '../../lib/maintainability/duplicates.cjs';
import { relatedOf } from '../types/finding-related.cjs';
import type { ImplementationIndex } from '../../lib/maintainability/types/duplicates.cjs';

const body = `{
  const cleaned = input.trim();
  if (!cleaned || cleaned.length > 20) return fallback;
  const pieces = cleaned.split("-");
  return pieces.map(piece => piece.toLowerCase()).join("_");
}`;
const implementation = (name: string) => `function ${name}(input: string, fallback: string) ${body}`;

function add(index: ImplementationIndex, file: string, source: string) {
  index.add(ts.createSourceFile(file, source, ts.ScriptTarget.Latest, true), file);
}

test('keeps documented independent comparison copies contextual only if one ordinary implementation remains', () => {
  const index = createDuplicateIndex();
  add(index, 'src/format.ts', implementation('format'));
  add(
    index,
    'tests/baseline.ts',
    "import {} from './harness';\n// The previous algorithm was kept here verbatim so the outputs\n// can be compared independently.\n" +
      implementation('reference'),
  );
  assert.match(String(index.findings()[0]?.contextualReason), /independent comparison/);
  add(index, 'tests/helper.ts', '// Compares two values with a reference.\n' + implementation('format'));
  const finding = index.findings()[0];
  assert.equal(relatedOf(finding).length, 2);
  assert.equal(finding?.contextualReason, undefined);
});

test('groups exact function bodies across files and methods, ignoring trivia', () => {
  const index = createDuplicateIndex();
  add(index, 'third.ts', 'class Model {\n  format(input: string, fallback: string) ' + body + '\n}');
  add(index, 'first.ts', '\n' + implementation('one'));
  add(index, 'second.ts', implementation('two').replace('return fallback;', '/* validated */ return  fallback;'));
  const findings = index.findings();
  assert.equal(findings.length, 1);
  const [result] = findings;
  assert.equal(result.ruleId, 'duplicate-implementation');
  assert.match(result.message, /extract one shared function/);
  assert.deepEqual([result.file, result.line, result.column], ['first.ts', 2, 10]);
  assert.deepEqual(result.related, [
    { file: 'second.ts', line: 1, column: 10 },
    { file: 'third.ts', line: 2, column: 3 },
  ]);
  assert.deepEqual(index.findings(), findings);
});

test('keeps different branches, operators, literals, parameters and async contracts distinct', () => {
  const index = createDuplicateIndex();
  const source = implementation('first');
  for (const [number, variant] of [
    source,
    source.replace('> 20', '>= 20'),
    source.replace('"-"', '"."'),
    source.replace('input: string, fallback: string', 'fallback: string, input: string'),
    source.replace('return fallback;', 'throw fallback;'),
    'async ' + source,
  ].entries())
    add(index, `module-${number}.ts`, variant);
  assert.deepEqual(index.findings(), []);
});

test('skips data-only functions, wrappers, generated or minified sources and repeated registration of one file', () => {
  const index = createDuplicateIndex();
  const dataOnly = 'function fixture(){const a = [1,2,3,4,5]; const b = {a, label:"something"}; return {a,b};}';
  const wrapper = 'function wrap(input: string, fallback: string) { return normalize(input, fallback); }';
  add(index, 'one.ts', [implementation('first'), dataOnly, wrapper].join('\n'));
  add(index, 'one.ts', implementation('again'));
  add(index, 'two.ts', [dataOnly, wrapper].join('\n'));
  add(index, 'client.generated.ts', implementation('client'));
  add(index, 'third.ts', '// @generated by schema compiler\n' + implementation('blended'));
  const bundledStatements = Array.from({ length: 60 }, (_, index) => `var v${index}="${'x'.repeat(40)}";`).join('');
  const minified = (name: string) => implementation(name).replaceAll(/\n\s*/g, ' ') + ';' + bundledStatements;
  add(index, 'bundle-a.mjs', minified('bundledA'));
  add(index, 'bundle-b.mjs', minified('bundledB'));
  assert.deepEqual(index.findings(), []);
});

test('handles named nested copies once and does not treat separate fragments as a function', () => {
  const index = createDuplicateIndex();
  for (const name of ['outerA', 'outerB']) {
    add(
      index,
      name + '.ts',
      `function ${name}(items: string[]) {
      const normalize = (input: string, fallback: string) => ${body};
      return items.map(item => normalize(item, 'unknown'));
    }`,
    );
  }
  const findings = index.findings();
  assert.equal(findings.length, 1);
  assert.equal(findings[0].line, 2);
});
