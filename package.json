{
  "name": "loadwise",
  "version": "0.4.1-preview.16",
  "type": "module",
  "description": "Find backend performance, maintainability and security issues, review suggested fixes, and check changed code locally or in CI.",
  "license": "Apache-2.0",
  "author": "Ibrahim Hafez",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/IbrahimHafez1/loadwise.git"
  },
  "bugs": {
    "url": "https://github.com/IbrahimHafez1/loadwise/issues"
  },
  "homepage": "https://github.com/IbrahimHafez1/loadwise#readme",
  "keywords": [
    "loadwise",
    "performance",
    "maintainability",
    "n-plus-one",
    "database",
    "orm",
    "prisma",
    "typeorm",
    "drizzle",
    "postgresql",
    "opentelemetry",
    "code-quality",
    "duplicate-code",
    "complexity",
    "architecture",
    "dependency-cycle",
    "static-analysis",
    "security",
    "cli",
    "vscode"
  ],
  "bin": {
    "loadwise": "./bin/loadwise.js"
  },
  "files": [
    "bin/",
    "lib/",
    "plugin/",
    "polyglot/",
    "schema/",
    "examples/",
    "editor/README.md",
    "editor/control-flow-comparison.cjs",
    "editor/finding-comparison.cjs",
    "editor/performance-examples.cjs",
    "editor/standalone-performance-examples.cjs",
    "editor/perf-site-comparison.cjs",
    "editor/maintainability-examples.cjs",
    "editor/security-examples.cjs",
    "editor/source-example.cjs",
    "editor/apply-fix.cjs",
    "PERFORMANCE.md",
    "LICENSE",
    "!**/*.cts",
    "!bin/**/*.ts",
    "!lib/**/*.ts",
    "!plugin/**/*.ts",
    "!polyglot/**/*.ts"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "format": "prettier --cache --write .",
    "format:check": "prettier --cache --check .",
    "lint": "oxlint --deny-warnings .",
    "check": "npm run format:check && npm run lint && npm run build && npm test",
    "typecheck": "tsc -p tsconfig.typecheck.json",
    "test": "npm run build && node --import ./test/manual-session.js --test --test-concurrency=8 test/performance/*.test.js test/maintainability/*.test.js test/security/*.test.js test/shared/*.test.js test/plugin/*.test.js editor/test/*.test.cjs",
    "selfscan:baseline": "node bin/loadwise.js check . --config scripts/self-scan/loadwise.config.json --write-baseline scripts/self-scan/loadwise-baseline.json",
    "bench:corpus": "node scripts/score-corpus.js",
    "bench:scorecard": "node scripts/score-corpus.js --scorecard",
    "bench:parity": "node scripts/engine-parity.js",
    "bench:patterns": "node bench/patterns.js",
    "bench:scan": "node bench/scanner.js",
    "bench:security": "node bench/security.js",
    "bench:traces": "node bench/traces.js",
    "bench:recall": "node bench/recall/runner.js",
    "build": "tsc -p tsconfig.json",
    "clean": "node -e \"import('node:fs').then(fs=>import('node:path').then(p=>{const walk=d=>{if(!fs.existsSync(d))return;for(const e of fs.readdirSync(d,{withFileTypes:true})){const f=p.join(d,e.name);if(e.isDirectory()&&e.name!=='node_modules'&&!f.includes('vendor'))walk(f);else if((e.name.endsWith('.js')&&fs.existsSync(f.slice(0,-3)+'.ts'))||(e.name.endsWith('.cjs')&&fs.existsSync(f.slice(0,-4)+'.cts')))fs.unlinkSync(f);}};['bin','lib','editor','plugin','polyglot','scripts','bench','test'].forEach(walk);fs.rmSync('.tsbuildinfo',{force:true});}))\"",
    "prepack": "npm run build",
    "prepare": "node -e \"import('node:child_process').then(c=>{c.execSync('git rev-parse --git-dir',{stdio:'ignore'});c.execSync('git config core.hooksPath hooks')}).catch(()=>{})\"",
    "lint:fix": "oxlint --fix ."
  },
  "dependencies": {
    "libpg-query": "18.2.2",
    "typescript": "6.0.3"
  },
  "optionalDependencies": {
    "@ast-grep/cli": "0.51.3",
    "@typescript/typescript-aix-ppc64": "7.1.0-beta",
    "@typescript/typescript-android-arm64": "7.1.0-beta",
    "@typescript/typescript-darwin-arm64": "7.1.0-beta",
    "@typescript/typescript-darwin-x64": "7.1.0-beta",
    "@typescript/typescript-freebsd-arm64": "7.1.0-beta",
    "@typescript/typescript-freebsd-x64": "7.1.0-beta",
    "@typescript/typescript-linux-arm": "7.1.0-beta",
    "@typescript/typescript-linux-arm64": "7.1.0-beta",
    "@typescript/typescript-linux-loong64": "7.1.0-beta",
    "@typescript/typescript-linux-mips64el": "7.1.0-beta",
    "@typescript/typescript-linux-ppc64": "7.1.0-beta",
    "@typescript/typescript-linux-riscv64": "7.1.0-beta",
    "@typescript/typescript-linux-s390x": "7.1.0-beta",
    "@typescript/typescript-linux-x64": "7.1.0-beta",
    "@typescript/typescript-netbsd-arm64": "7.1.0-beta",
    "@typescript/typescript-netbsd-x64": "7.1.0-beta",
    "@typescript/typescript-openbsd-arm64": "7.1.0-beta",
    "@typescript/typescript-openbsd-x64": "7.1.0-beta",
    "@typescript/typescript-sunos-x64": "7.1.0-beta",
    "@typescript/typescript-win32-arm64": "7.1.0-beta",
    "@typescript/typescript-win32-x64": "7.1.0-beta"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "oxlint": "1.94.0",
    "prettier": "3.10.1"
  }
}
