{
  "name": "backend-perf-check",
  "version": "0.3.0",
  "description": "Check backend query performance, transaction usage and project-defined query policies in source code, traces and execution plans.",
  "license": "UNLICENSED",
  "author": "Ibrahim Hafez",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/IbrahimHafez1/backend-perf-check.git"
  },
  "bugs": {
    "url": "https://github.com/IbrahimHafez1/backend-perf-check/issues"
  },
  "homepage": "https://github.com/IbrahimHafez1/backend-perf-check#readme",
  "keywords": [
    "performance",
    "n-plus-one",
    "database",
    "orm",
    "prisma",
    "typeorm",
    "drizzle",
    "postgresql",
    "opentelemetry",
    "static-analysis",
    "cli",
    "vscode"
  ],
  "bin": {
    "backend-perf-check": "./bin/backend-perf-check.cjs"
  },
  "files": [
    "bin/",
    "lib/",
    "polyglot/",
    "examples/",
    "editor/README.md",
    "editor/control-flow-comparison.cjs",
    "editor/finding-comparison.cjs",
    "editor/performance-examples.cjs",
    "editor/perf-site-comparison.cjs",
    "editor/maintainability-examples.cjs",
    "editor/source-example.cjs",
    "editor/apply-fix.cjs",
    "PERFORMANCE.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "format": "prettier --cache --write .",
    "format:check": "prettier --cache --check .",
    "lint": "oxlint --deny-warnings .",
    "check": "npm run format:check && npm run lint && npm test",
    "test": "node --test --test-concurrency=2 test/*.test.cjs editor/test/*.test.cjs",
    "bench:patterns": "node bench/patterns.cjs",
    "bench:scan": "node bench/scanner.cjs",
    "bench:traces": "node bench/traces.cjs"
  },
  "dependencies": {
    "libpg-query": "18.2.2",
    "typescript": "6.0.3"
  },
  "optionalDependencies": {
    "@ast-grep/cli": "0.51.3",
    "@typescript/typescript-aix-ppc64": "7.1.0-beta",
    "@typescript/typescript-android-arm64": "7.1.0-beta",
    "@typescript/typescript-darwin-arm64": "7.1.0-beta",
    "@typescript/typescript-darwin-x64": "7.1.0-beta",
    "@typescript/typescript-freebsd-arm64": "7.1.0-beta",
    "@typescript/typescript-freebsd-x64": "7.1.0-beta",
    "@typescript/typescript-linux-arm": "7.1.0-beta",
    "@typescript/typescript-linux-arm64": "7.1.0-beta",
    "@typescript/typescript-linux-loong64": "7.1.0-beta",
    "@typescript/typescript-linux-mips64el": "7.1.0-beta",
    "@typescript/typescript-linux-ppc64": "7.1.0-beta",
    "@typescript/typescript-linux-riscv64": "7.1.0-beta",
    "@typescript/typescript-linux-s390x": "7.1.0-beta",
    "@typescript/typescript-linux-x64": "7.1.0-beta",
    "@typescript/typescript-netbsd-arm64": "7.1.0-beta",
    "@typescript/typescript-netbsd-x64": "7.1.0-beta",
    "@typescript/typescript-openbsd-arm64": "7.1.0-beta",
    "@typescript/typescript-openbsd-x64": "7.1.0-beta",
    "@typescript/typescript-sunos-x64": "7.1.0-beta",
    "@typescript/typescript-win32-arm64": "7.1.0-beta",
    "@typescript/typescript-win32-x64": "7.1.0-beta"
  },
  "devDependencies": {
    "oxlint": "1.94.0",
    "prettier": "3.10.1"
  }
}
