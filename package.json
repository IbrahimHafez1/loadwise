{
  "name": "maintainability-check",
  "version": "0.2.0",
  "description": "Review source complexity, duplicate implementations and project-defined architecture across languages.",
  "license": "UNLICENSED",
  "author": "Ibrahim Hafez",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/IbrahimHafez1/maintainability-check.git"
  },
  "bugs": {
    "url": "https://github.com/IbrahimHafez1/maintainability-check/issues"
  },
  "homepage": "https://github.com/IbrahimHafez1/maintainability-check#readme",
  "keywords": [
    "maintainability",
    "code-quality",
    "duplicate-code",
    "complexity",
    "architecture",
    "dependency-cycle",
    "static-analysis",
    "cli",
    "vscode"
  ],
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "maintainability-check": "bin/maintainability-check.cjs"
  },
  "files": [
    "bin/",
    "lib/",
    "polyglot/",
    "LICENSE"
  ],
  "scripts": {
    "format": "prettier --cache --write .",
    "format:check": "prettier --cache --check .",
    "lint": "oxlint --deny-warnings .",
    "check": "npm run format:check && npm run lint && npm test",
    "test": "node --test --test-concurrency=2 test/*.test.cjs"
  },
  "dependencies": {
    "typescript": "6.0.3"
  },
  "optionalDependencies": {
    "@ast-grep/cli": "0.51.3"
  },
  "devDependencies": {
    "oxlint": "1.94.0",
    "prettier": "3.10.1"
  }
}
