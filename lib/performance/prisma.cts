import fs from 'node:fs';
import path from 'node:path';
import { loadSyntax } from './compiler.cjs';
import { noteUnreadable } from '../shared/coverage-notes.cjs';
import { findPrismaSchemaFiles, loadPrismaSchema } from './schema/prisma-schema.cjs';
import {
  awaitedResult,
  chainedMethod,
  clientSideQuery,
  consumesLazyQuery,
  firstElementRead,
  isDiscardedValue,
  outsideWrappers,
} from './query-results.cjs';
import { findRepeatOwner } from './repeated.cjs';
import { shouldReportLoopQuery } from './query-loops.cjs';
import { isSequentialByDesign } from './sequential-loops.cjs';
import type {
  ArrowFunction,
  AwaitExpression,
  CallExpression,
  Expression,
  FunctionExpression,
  Identifier,
  MemberName,
  MethodDeclaration,
  Node,
  ObjectLiteralElementLike,
  PropertyAssignment,
  SourceFile,
  StringLiteral,
  TaggedTemplateExpression,
} from 'typescript';
import type { CheckerAdapter, PerformanceRuleContext } from '../shared/types.cjs';
import type { SchemaTable } from './types/schema-model.cjs';
const ts = loadSyntax();

const READ_OPERATIONS = new Set([
  'findUnique',
  'findUniqueOrThrow',
  'findFirst',
  'findFirstOrThrow',
  'findMany',
  'count',
  'aggregate',
  'groupBy',
]);
const SINGLE_ROW_WRITES = new Set(['create', 'update', 'delete', 'upsert']);
const RAW_TEMPLATE_TAGS = new Set(['$queryRaw', '$executeRaw']);
const promiseMethods = new Set(['then', 'catch', 'finally']);
const COUNT_OPTIONS = new Set(['where']);
const ZERO_COMPARISONS = new Set([
  ts.SyntaxKind.EqualsEqualsEqualsToken,
  ts.SyntaxKind.ExclamationEqualsEqualsToken,
  ts.SyntaxKind.EqualsEqualsToken,
  ts.SyntaxKind.ExclamationEqualsToken,
]);
const EXISTENCE_THRESHOLDS = new Map([
  [ts.SyntaxKind.GreaterThanToken, { left: 0, right: 1 }],
  [ts.SyntaxKind.LessThanEqualsToken, { left: 0, right: 1 }],
  [ts.SyntaxKind.GreaterThanEqualsToken, { left: 1, right: 0 }],
  [ts.SyntaxKind.LessThanToken, { left: 1, right: 0 }],
]);
const ITERATING_METHODS = new Set(['map', 'forEach', 'flatMap']);
const UNTYPED_COLLECTION_REASON =
  'The iterated collection is untyped, so its size is unknown. Review whether it can grow large.';
const FIRST_OPTIONS = new Set(['where', 'orderBy', 'select', 'include', 'omit']);
const FILTER_SORT_OPTIONS = new Set(['where', 'orderBy', 'select']);
const PRISMA_PACKAGE_PATH = /\/node_modules\/(?:@prisma\/client|\.prisma\/client)\//;
const generatedFiles = new WeakMap<SourceFile, boolean>();
const DELEGATE_OPERATIONS = new Set([
  ...READ_OPERATIONS,
  ...SINGLE_ROW_WRITES,
  'createMany',
  'createManyAndReturn',
  'updateMany',
  'updateManyAndReturn',
  'deleteMany',
]);
const SCHEMA_MODEL_BLOCK = /^[ \t]*(?:model|view)[ \t]+(\w+)[ \t]*\{/gm;
const CLIENT_RECEIVER_NAME = /prisma|^(?:tx|trx|db|transaction)$/i;
const delegatesByDirectory = new Map<string, Map<string, string>>();
const delegatesByOwner = new Map<string, Map<string, string>>();
const packagesByRepository = new Map<string, string[]>();

// A property assignment whose name is a plain identifier or string, as written in a Prisma options
// object.
interface KeyedAssignment extends PropertyAssignment {
  name: Identifier | StringLiteral;
}

function isGeneratedPrismaFile(file: SourceFile): boolean {
  if (!generatedFiles.has(file)) {
    // The modern generator emits each model into the application's own directory.
    const fromPackage = PRISMA_PACKAGE_PATH.test(file.fileName.replaceAll('\\', '/'));
    const fromGenerator =
      !fromPackage &&
      file.statements.length > 0 &&
      file.text.slice(0, file.statements[0].getStart(file)).includes('This is code generated by Prisma') &&
      file.statements.some(
        (statement) =>
          ts.isImportDeclaration(statement) &&
          ts.isStringLiteral(statement.moduleSpecifier) &&
          statement.moduleSpecifier.text.startsWith('@prisma/client/runtime/'),
      );
    generatedFiles.set(file, fromPackage || fromGenerator);
  }
  return generatedFiles.get(file) === true;
}

function consumesPrismaQuery(call: CallExpression, checker: CheckerAdapter) {
  const chained = chainedMethod(call)?.expression.name.text;
  return consumesLazyQuery(call, checker) || (chained !== undefined && promiseMethods.has(chained));
}

function delegateName(owner: Node): string | undefined {
  if (
    ts.isInterfaceDeclaration(owner) &&
    owner.name.text.endsWith('Delegate') &&
    isGeneratedPrismaFile(owner.getSourceFile())
  ) {
    return owner.name.text.slice(0, -'Delegate'.length);
  }
}

const unreadableConsequence = 'its Prisma schema models were skipped';

function readText(filename: string) {
  try {
    return fs.readFileSync(filename, 'utf8');
  } catch (error) {
    if (error instanceof Error) noteUnreadable({ error, location: filename, consequence: unreadableConsequence });
    return undefined;
  }
}

function hasManifest(directory: string) {
  return fs.existsSync(path.join(directory, 'package.json'));
}

function isRepositoryRoot(directory: string) {
  return fs.existsSync(path.join(directory, '.git')) || fs.existsSync(path.join(directory, 'pnpm-workspace.yaml'));
}

function childDirectories(directory: string) {
  try {
    return fs
      .readdirSync(directory, { withFileTypes: true })
      .filter((entry) => entry.isDirectory() && entry.name !== 'node_modules' && !entry.name.startsWith('.'))
      .map((entry) => path.join(directory, entry.name));
  } catch (error) {
    if (error instanceof Error) noteUnreadable({ error, location: directory, consequence: unreadableConsequence });
    return [];
  }
}

// The packages whose schema may define the client a file uses: the file's own package and its
// ancestors, and in a repository every package up to two levels down (`packages/prisma`,
// `apps/api`), where a client wrapper lives.
function schemaOwnerDirectories(sourceDirectory: string): Set<string> {
  const owners = new Set<string>();
  let repositoryRoot: string | undefined;
  for (let current = sourceDirectory; ; current = path.dirname(current)) {
    if (hasManifest(current)) owners.add(current);
    if (isRepositoryRoot(current)) {
      repositoryRoot = current;
      break;
    }
    if (path.dirname(current) === current) break;
  }
  for (const workspacePackage of repositoryRoot ? repositoryPackages(repositoryRoot) : []) owners.add(workspacePackage);
  return owners;
}

function repositoryPackages(repositoryRoot: string): string[] {
  let packages = packagesByRepository.get(repositoryRoot);
  if (!packages) {
    const packageLevel = childDirectories(repositoryRoot);
    const candidates = [...packageLevel, ...packageLevel.flatMap(childDirectories)];
    packages = candidates.filter(hasManifest);
    packagesByRepository.set(repositoryRoot, packages);
  }
  return packages;
}

function ownerDelegates(owner: string): Map<string, string> {
  let delegates = delegatesByOwner.get(owner);
  if (!delegates) {
    delegates = new Map<string, string>();
    for (const schemaFile of findPrismaSchemaFiles(owner)) {
      for (const [, modelName] of (readText(schemaFile) ?? '').matchAll(SCHEMA_MODEL_BLOCK)) {
        delegates.set(modelName[0].toLowerCase() + modelName.slice(1), modelName);
      }
    }
    delegatesByOwner.set(owner, delegates);
  }
  return delegates;
}

// Maps each client delegate property (`eventType`) to its model name (`EventType`).
function schemaDelegates(sourceFile: SourceFile): Map<string, string> {
  const sourceDirectory = path.dirname(path.resolve(sourceFile.fileName));
  let delegates = delegatesByDirectory.get(sourceDirectory);
  if (!delegates) {
    delegates = new Map<string, string>();
    for (const owner of schemaOwnerDirectories(sourceDirectory)) {
      for (const [delegate, modelName] of ownerDelegates(owner)) delegates.set(delegate, modelName);
    }
    delegatesByDirectory.set(sourceDirectory, delegates);
  }
  return delegates;
}

// Without a generated client `prisma.user.findMany` resolves to nothing. A receiver named like a
// client whose delegate property is unknown to the checker and matches a schema model is taken as
// Prisma, at lower precision.
function modelNameFromSchema(methodName: Node, checker: CheckerAdapter): string | undefined {
  const access = methodName.parent;
  const operationName = ts.isIdentifier(methodName) || ts.isStringLiteralLike(methodName) ? methodName.text : undefined;
  if (
    operationName === undefined ||
    !DELEGATE_OPERATIONS.has(operationName) ||
    !ts.isPropertyAccessExpression(access) ||
    access.name !== methodName
  ) {
    return;
  }
  const delegate = access.expression;
  if (!ts.isPropertyAccessExpression(delegate) || checker.getSymbolAtLocation(delegate.name)) return;
  const client = delegate.expression;
  const clientName = ts.isIdentifier(client) ? client.text : ts.isPropertyAccessExpression(client) && client.name.text;
  if (!clientName || !CLIENT_RECEIVER_NAME.test(clientName)) return;
  return schemaDelegates(methodName.getSourceFile()).get(delegate.name.text);
}

function prismaModelName(methodName: Node, checker: CheckerAdapter): string | undefined {
  const declarations = checker.getSymbolAtLocation(methodName)?.declarations;
  if (!declarations?.length) return modelNameFromSchema(methodName, checker);
  if (declarations?.length && declarations.every((declaration) => declaration.parent === declarations[0].parent)) {
    return delegateName(declarations[0].parent);
  }
}

function prismaModelNameFromReceiver(receiver: Expression, checker: CheckerAdapter) {
  const declarations = checker.getTypeAtLocation(receiver).getSymbol()?.declarations;
  if (declarations?.length === 1) return delegateName(declarations[0]);
}

function singlePrimaryKeyField(table: SchemaTable): string | undefined {
  const primaryIndexes = table.indexes.filter((index) => index.primary);
  if (primaryIndexes.length !== 1 || primaryIndexes[0].keys.length !== 1) return;
  return primaryIndexes[0].keys[0].column;
}

// The model's single-column primary key, or undefined when it has none, a compound one, or packages
// disagree.
function modelIdField(sourceFile: SourceFile, modelName: string): string | undefined {
  const sourceDirectory = path.dirname(path.resolve(sourceFile.fileName));
  const idFields = new Set<string | undefined>();
  for (const owner of schemaOwnerDirectories(sourceDirectory)) {
    const table = loadPrismaSchema(owner)?.models.get(modelName);
    if (table) idFields.add(singlePrimaryKeyField(table));
  }
  return idFields.size === 1 ? [...idFields][0] : undefined;
}

// A callback passed to `.map`/`.forEach` on a receiver of type `any` is not recognised as an array
// iteration, so its queries would never count as per-item. The callback is still the repeating
// scope, at lower precision.
function untypedIterationCallback(
  call: CallExpression,
  checker: CheckerAdapter,
): ArrowFunction | FunctionExpression | MethodDeclaration | undefined {
  const callback = ts.findAncestor(call, ts.isFunctionLike);
  if (
    !callback ||
    (!ts.isArrowFunction(callback) && !ts.isFunctionExpression(callback) && !ts.isMethodDeclaration(callback)) ||
    callback.asteriskToken
  )
    return;
  let argument: Node = callback;
  while (ts.isOuterExpression(argument.parent) && argument.parent.expression === argument) argument = argument.parent;
  const iteration = argument.parent;
  if (
    !ts.isCallExpression(iteration) ||
    iteration.arguments[0] !== argument ||
    !ts.isPropertyAccessExpression(iteration.expression) ||
    !ITERATING_METHODS.has(iteration.expression.name.text)
  )
    return;
  const receiverType = checker.getTypeAtLocation(iteration.expression.expression);
  if (receiverType.flags & ts.TypeFlags.Any) return callback;
}

// An await earlier in the same callback defers the call past the tick in which the other items'
// calls start.
function awaitsBefore(call: CallExpression, owner: Node): boolean {
  let found = false;
  (function visit(node: Node) {
    if (found || node.pos >= call.pos || (node !== owner && ts.isFunctionLike(node))) return;
    if (ts.isAwaitExpression(node) && node.end <= call.pos) found = true;
    else ts.forEachChild(node, visit);
  })(owner);
  return found;
}

function readsResultLength(awaited: AwaitExpression): boolean {
  const receiver = outsideWrappers(awaited);
  const access = receiver.parent;
  return (
    ts.isPropertyAccessExpression(access) &&
    access.expression === receiver &&
    access.name.text === 'length' &&
    !ts.isAssignmentTarget(access) &&
    !ts.isDeleteExpression(outsideWrappers(access).parent) &&
    !isDiscardedValue(access)
  );
}

function hasOnlyOptions(call: CallExpression, allowed: ReadonlySet<string>): boolean {
  if (call.arguments.length === 0) return true;
  const [options] = call.arguments;
  return (
    call.arguments.length === 1 &&
    ts.isObjectLiteralExpression(options) &&
    options.properties.every(
      (property) =>
        (ts.isPropertyAssignment(property) || ts.isShorthandPropertyAssignment(property)) &&
        (ts.isIdentifier(property.name) || ts.isStringLiteral(property.name)) &&
        allowed.has(property.name.text),
    )
  );
}

function countForExistence(call: CallExpression) {
  if (ts.isOptionalChain(call)) return false;
  const awaited = awaitedResult(call);
  if (!awaited) return false;
  const count = outsideWrappers(awaited);
  const comparison = count.parent;
  if (!ts.isBinaryExpression(comparison)) return false;

  const countOnLeft = comparison.left === count;
  let threshold = countOnLeft ? comparison.right : comparison.left;
  while (ts.isParenthesizedExpression(threshold)) threshold = threshold.expression;
  if (!ts.isNumericLiteral(threshold)) return false;

  const operator = comparison.operatorToken.kind;
  const thresholds = EXISTENCE_THRESHOLDS.get(operator);
  const expected = ZERO_COMPARISONS.has(operator) ? 0 : thresholds?.[countOnLeft ? 'left' : 'right'];
  return Number(threshold.text) === expected && hasOnlyOptions(call, COUNT_OPTIONS);
}

function isKeyedAssignment(property: ObjectLiteralElementLike): property is KeyedAssignment {
  return ts.isPropertyAssignment(property) && (ts.isIdentifier(property.name) || ts.isStringLiteral(property.name));
}

function projectsField(call: CallExpression, field: string): boolean {
  if (!hasOnlyOptions(call, FILTER_SORT_OPTIONS)) return false;
  const [options] = call.arguments;
  const selection =
    options && ts.isObjectLiteralExpression(options)
      ? options.properties.find((property) => isKeyedAssignment(property) && property.name.text === 'select')
      : undefined;
  if (!selection) return true;
  if (!ts.isPropertyAssignment(selection) || !ts.isObjectLiteralExpression(selection.initializer)) return false;
  const projected = selection.initializer.properties;
  return (
    projected.every(isKeyedAssignment) &&
    projected.some(
      (property) =>
        isKeyedAssignment(property) &&
        property.name.text === field &&
        property.initializer.kind === ts.SyntaxKind.TrueKeyword,
    )
  );
}

function repeatedOperationAdvice(operation: string) {
  if (SINGLE_ROW_WRITES.has(operation)) {
    return 'Use `createMany`, `updateMany` or `deleteMany` with an `in` filter if validation, ordering and transaction semantics allow it.';
  }
  if (operation.startsWith('findUnique')) {
    return 'Prisma may batch same-tick findUnique calls, but a single `findMany({ where: { id: { in: ids } } })` guarantees one query.';
  }
  return 'Fetch all keys in one query, for example `findMany({ where: { id: { in: ids } } })`, or use `include`/`groupBy`, then index the rows in a Map.';
}

function checkPrismaCall(call: CallExpression, context: PerformanceRuleContext) {
  const access = call.expression;
  if (!ts.isPropertyAccessExpression(access)) return;
  const operation = access.name.text;
  if (!READ_OPERATIONS.has(operation) && !SINGLE_ROW_WRITES.has(operation)) return;

  const awaited = operation === 'findMany' && awaitedResult(call);
  const readsCount = awaited && readsResultLength(awaited) && hasOnlyOptions(call, COUNT_OPTIONS);
  const readsFirst = awaited && firstElementRead(awaited) && hasOnlyOptions(call, FIRST_OPTIONS);
  const testsExistence = operation === 'count' && countForExistence(call);
  const clientSide = awaited && clientSideQuery(awaited);
  const canPushDown = clientSide && projectsField(call, clientSide.field);
  const typedOwner = findRepeatOwner(call, context.checker);
  const untypedOwner = !typedOwner && untypedIterationCallback(call, context.checker);
  const repeatOwner = typedOwner || untypedOwner || undefined;
  // Same-tick findUnique calls can share Prisma's dataloader: callbacks run synchronously up to
  // their first await, so only an await before the call, or a sequential await in a loop, defeats
  // it.
  const mayBatch =
    operation.startsWith('findUnique') &&
    repeatOwner &&
    (ts.isFunctionLike(repeatOwner) ? !awaitsBefore(call, repeatOwner) : !awaitedResult(call));
  const inLoop = repeatOwner && !mayBatch && consumesPrismaQuery(call, context.checker);
  if (!readsCount && !readsFirst && !testsExistence && !canPushDown && !inLoop) return;

  const modelName = prismaModelName(access.name, context.checker);
  if (!modelName) return;

  if (readsCount) {
    context.report(
      access.name,
      'prisma-count-materialization',
      'findMany() loads every matching row only to read its length. Use `prisma.model.count({ where })` with the same filter.',
    );
  }
  if (testsExistence) {
    context.report(
      access.name,
      'prisma-count-for-existence',
      'This count() comparison only checks whether any row exists. Use `findFirst` on the same delegate with the same `where` and a small scalar projection, then check whether the result is null.',
      undefined,
      // The fix selects this field; the finding carries it because the fix builder cannot resolve
      // the model itself.
      { idField: modelIdField(call.getSourceFile(), modelName) },
    );
  }
  if (readsFirst) {
    context.report(
      access.name,
      'prisma-first-materialization',
      'findMany() loads every matching row but only the first is read. Use `findFirst({ where, orderBy, select })` with a deterministic orderBy; it returns null (not undefined) when empty.',
    );
  }
  if (canPushDown) {
    if (clientSide.method.text === 'filter') {
      context.report(
        clientSide.method,
        'prisma-filter-materialization',
        'findMany() loads rows that JavaScript then filters by one field. Move the test into the query with `where: { AND: [where, { field: value }] }`; check NULL handling and comparison semantics.',
      );
    } else {
      context.report(
        clientSide.method,
        'prisma-top-k-materialization',
        "findMany() loads all rows that JavaScript then sorts and truncates. Use `orderBy: { field: 'desc' }, take: limit` in the query; keep NULL ordering and tie behavior.",
      );
    }
  }
  if (
    inLoop &&
    !isSequentialByDesign(call, repeatOwner) &&
    shouldReportLoopQuery(call, context.checker, { family: 'Prisma', method: operation, owner: repeatOwner })
  ) {
    context.report(
      access.name,
      'prisma-query-in-loop',
      `Prisma ${operation}() runs once per iteration, adding a round trip per item. ${repeatedOperationAdvice(operation)}`,
      untypedOwner ? UNTYPED_COLLECTION_REASON : undefined,
    );
  }
}

function isPrismaClientMember(name: MemberName, checker: CheckerAdapter) {
  return !!checker
    .getSymbolAtLocation(name)
    ?.declarations?.some(
      (declaration) =>
        PRISMA_PACKAGE_PATH.test(declaration.getSourceFile().fileName.replaceAll('\\', '/')) ||
        isGeneratedPrismaFile(declaration.getSourceFile()),
    );
}

// Raw statements are tagged templates such as tx.$executeRaw`...`, not calls, so checkPrismaCall
// never sees them.
function checkPrismaRawTemplate(node: TaggedTemplateExpression, context: PerformanceRuleContext) {
  const tag = node.tag;
  if (!ts.isPropertyAccessExpression(tag) || !RAW_TEMPLATE_TAGS.has(tag.name.text)) return;
  const owner = findRepeatOwner(node, context.checker);
  if (!owner || !consumesLazyQuery(node, context.checker) || !isPrismaClientMember(tag.name, context.checker)) return;
  if (isSequentialByDesign(node, owner) || !shouldReportLoopQuery(node, context.checker, { owner })) return;
  context.report(
    tag.name,
    'prisma-query-in-loop',
    `Prisma ${tag.name.text} runs one raw statement per iteration, adding a round trip per item. Send one set-based statement for all items, for example \`WHERE id = ANY(\${ids})\` or \`UPDATE ... FROM (VALUES ...)\`, if per-row values, ordering and results allow it.`,
  );
}

export {
  checkPrismaCall,
  checkPrismaRawTemplate,
  childDirectories,
  consumesPrismaQuery,
  isGeneratedPrismaFile,
  prismaModelName,
  prismaModelNameFromReceiver,
};
