// Only the call that starts a Drizzle statement is counted, so one chained statement is one
// operation.
const drizzleOperations = new Set([
  'select',
  'selectDistinct',
  'selectDistinctOn',
  'insert',
  'update',
  'delete',
  'execute',
  'findFirst',
  'findMany',
]);
const redisOperations = new Set([
  'get',
  'set',
  'setex',
  'getdel',
  'getex',
  'mget',
  'mset',
  'hget',
  'hset',
  'hmget',
