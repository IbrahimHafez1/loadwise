// The client packages Loadwise knows as database, cache and queue clients, and the methods of each
// that cost a round trip. Pure data: the loop analysis in service-loops.cjs decides what a call to
// one of them means.

/** A client package family and the methods of it that cost a round trip. */
interface PackageOperations {
  family: string;
  packages: readonly string[];
  operations: ReadonlySet<string>;
  /** Only methods declared on these types count. */
  owners?: ReadonlySet<string>;
}

const prismaOperations = new Set([
  'findUnique',
  'findUniqueOrThrow',
  'findFirst',
  'findFirstOrThrow',
  'findMany',
  'count',
  'aggregate',
  'groupBy',
  'create',
  'createMany',
  'createManyAndReturn',
  'update',
  'updateMany',
  'updateManyAndReturn',
  'upsert',
  'delete',
  'deleteMany',
  '$queryRaw',
  '$queryRawUnsafe',
  '$executeRaw',
  '$executeRawUnsafe',
]);
// Repository.create and merge build entities in memory and are deliberately absent.
const typeormOperations = new Set([
  'find',
  'findBy',
  'findByIds',
  'findOne',
